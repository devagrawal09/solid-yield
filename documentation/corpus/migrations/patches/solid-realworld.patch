+import { action, createMemo, createSignal, refresh } from "solid-js";
+import type { Agent, Result } from "./createAgent";
+import type { Comment } from "../types";
+
+export default function createComments(agent: Agent) {
+  // New: the last failed action, shown by App. A catch that writes a signal declared here counts
+  // as handling; a setter received as a parameter is reported as CATCH_SWALLOWS.
+  const [error, setError] = createSignal<string | undefined>(undefined);
+  const [articleSlug, setArticleSlug] = createSignal<string | undefined>(undefined);
+  const comments = createMemo(() => {
+    const slug = articleSlug();
+    return slug ? agent.Comments.forArticle(slug) : [];
+  });
+  const actions = {
+    loadComments: action(function* (slug: string, reload?: boolean) {
+      if (reload) refresh(comments);
+      else setArticleSlug(slug);
+    }),
+    createComment: action(function* (comment: { body: string }) {
+      const { errors }: Result<"comment", Comment> = yield agent.Comments.create(String(articleSlug()), comment);
+      if (errors) throw errors;
+    }),
+    // Was an optimistic mutate() of the resource; now delete, then refetch.
+    deleteComment: action(function* (id: number) {
+      setError(undefined);
+      try {
+        yield agent.Comments.delete(String(articleSlug()), id);
+        refresh(comments);
+      } catch (err) {
+        setError("Could not delete the comment.");
+      }
+    })
+  };
+  return { error, comments, articleSlug, actions };
+}
