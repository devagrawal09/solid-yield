diff --git a/vite.config.mts b/vite.config.mts
new file mode 100644
index 0000000..20b0d00
--- /dev/null
+++ b/vite.config.mts
@@ -0,0 +1,53 @@
+import { defineConfig } from "vite";
+import solid from "@solidjs/vite-plugin";
+import solidYield from "vite-plugin-solid-yield";
+import path from "path";
+
+// PLAIN=1 builds plain Solid 2 (Solid's plugin only); otherwise the solid-yield native lowering runs first.
+const plain = !!process.env.PLAIN;
+// YIELD_EXCLUDE=a.tsx,b.tsx (paths relative to src/) leaves files that still have native transform errors out of the
+// solid-yield selection: the plugin aborts the whole build on any transform error (they stay plain Solid 2).
+const src = path.resolve(import.meta.dirname, "src") + "/";
+const excluded = (process.env.YIELD_EXCLUDE ?? "").split(",").filter(Boolean).map((f) => src + f);
+const nativeInclude = excluded.length
+  ? (file: string) => file.startsWith(src) && /\.tsx?$/.test(file) && !excluded.includes(file)
+  : ["src/**"];
+
+export default defineConfig({
+  plugins: [...(plain ? [] : [solidYield({ mode: "native", include: nativeInclude })]), solid()],
+  build: {
+    target: "esnext",
+    minify: !process.env.DEBUG_BUILD,
+    sourcemap: !!process.env.DEBUG_BUILD,
+    outDir: process.env.OUT_DIR ?? "dist",
+    chunkSizeWarningLimit: 3000, // data-sdk is 2.4 MB
+    rollupOptions: {
+      output: {
+        manualChunks(id) {
+          if (id.includes("src/routes/quiz") || id.includes("src/components/quiz")) {
+            return "quiz";
+          }
+          if (id.includes("data/src/sdk/data.ts") || id.includes("data/src/sdk/index.ts") || (id.includes("data/src/") && id.endsWith(".json"))) {
+            return "data-sdk";
+          }
+        },
+      },
+    },
+  },
+  server: {
+    watch: {
+      ignored: ["**/data/source/**"],
+    },
+  },
+  define: {
+    "import.meta.env.DATA_URL": '"http://localhost:3000/data"',
+    "import.meta.env.IMG_BASE_URL": '"/"',
+  },
+  resolve: {
+    alias: {
+      "@data": path.resolve(import.meta.dirname, "./data/src"),
+      "@components": path.resolve(import.meta.dirname, "./src/components"),
+    },
+  },
+  publicDir: "data/images",
+});
