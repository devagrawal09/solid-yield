+import { createEffect, createStore, useContext } from "solid-js";
+import { StoreContext } from "../store";
+import ListErrors from "../components/ListErrors";
+import { isErrors, type Errors, type UserUpdate } from "../types";
+
+type Field = "image" | "username" | "bio" | "email" | "password";
+
+export default function Settings() {
+  const [store, { logout, updateUser }] = useContext(StoreContext),
+    [state, setState] = createStore<{
+      image: string;
+      username: string;
+      bio: string;
+      email: string;
+      password: string;
+      updatingUser?: boolean;
+      errors?: Errors;
+    }>({ image: "", username: "", bio: "", email: "", password: "" }),
+    updateState = (field: Field, ev: Event & { currentTarget: HTMLInputElement | HTMLTextAreaElement }) => {
+      const value = ev.currentTarget.value;
+      setState(s => {
+        s[field] = value;
+      });
+    },
+    submitForm = async (ev: SubmitEvent) => {
+      ev.preventDefault();
+      // Was Object.assign({}, state): copying a store is typed as copying its Source.
+      const user: UserUpdate = {
+        image: state.image,
+        username: state.username,
+        bio: state.bio,
+        email: state.email,
+        password: state.password
+      };
+      if (!user.password) delete user.password;
+      if (!user.image) delete user.image;
+      setState(s => {
+        s.updatingUser = true;
+      });
+      try {
+        await updateUser(user);
+        location.hash = `/@${user.username}`;
+      } catch (errors) {
+        setState(s => {
+          s.errors = isErrors(errors) ? errors : { error: [String(errors)] };
+        });
+      } finally {
+        setState(s => {
+          s.updatingUser = false;
+        });
+      }
+    };
+
+  // The form was initialised from store.currentUser in the component body (a setup read);
+  // untrack() has no native lowering, so an effect copies the loaded user into the form.
+  createEffect(
+    () => store.currentUser(),
+    user => {
+      if (user)
+        setState(s => {
+          s.image = user.image || "";
+          s.username = user.username;
+          s.bio = user.bio || "";
+          s.email = user.email;
+        });
+    }
+  );
+
+  return (
+    <div class="settings-page">
+      <div class="container page">
+        <div class="row">
+          <div class="col-md-6 offset-md-3 col-xs-12">
+            <h1 class="text-xs-center">Your Settings</h1>
+            <ListErrors errors={state.errors} />
+            <form onSubmit={submitForm}>
+              <fieldset>
+                <fieldset class="form-group">
+                  <input
+                    class="form-control"
+                    type="text"
+                    placeholder="URL of profile picture"
+                    value={state.image}
+                    onChange={e => updateState("image", e)}
+                    disabled={state.updatingUser}
+                  />
+                </fieldset>
+                <fieldset class="form-group">
+                  <input
+                    class="form-control form-control-lg"
+                    type="text"
+                    placeholder="Your Name"
+                    value={state.username}
+                    onChange={e => updateState("username", e)}
+                    disabled={state.updatingUser}
+                  />
+                </fieldset>
+                <fieldset class="form-group">
+                  <textarea
+                    class="form-control form-control-lg"
+                    rows="8"
+                    placeholder="Short bio about you"
+                    value={state.bio}
+                    onChange={e => updateState("bio", e)}
+                    disabled={state.updatingUser}
+                  ></textarea>
+                </fieldset>
+                <fieldset class="form-group">
+                  <input
+                    class="form-control form-control-lg"
+                    type="text"
+                    placeholder="Email"
+                    value={state.email}
+                    onChange={e => updateState("email", e)}
+                    disabled={state.updatingUser}
+                  />
+                </fieldset>
+                <fieldset class="form-group">
+                  <input
+                    class="form-control form-control-lg"
+                    type="password"
+                    placeholder="Password"
+                    value={state.password}
+                    onChange={e => updateState("password", e)}
+                    disabled={state.updatingUser}
+                  />
+                </fieldset>
+                <button
+                  class="btn btn-lg btn-primary pull-xs-right"
+                  type="submit"
+                  disabled={state.updatingUser}
+                >
+                  Update Settings
+                </button>
+              </fieldset>
+            </form>
+            <hr />
+            <button
+              class="btn btn-outline-danger"
+              onClick={() => (logout(), (location.hash = "/"))}
+            >
+              Or click here to logout.
+            </button>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
