+import { For, Show } from "solid-js";
+import type { Errors } from "../types";
+
+export default function ListErrors(props: { errors?: Errors }) {
+  return (
+    <Show when={props.errors}>
+      {errors => (
+        <ul class="error-messages">
+          <For each={Object.keys(errors())}>
+            {key => (
+              <li>
+                {key} {errors()[key]}
+              </li>
+            )}
+          </For>
+        </ul>
+      )}
+    </Show>
+  );
+}
