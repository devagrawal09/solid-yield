+import marked from "marked";
+import { Show, useContext } from "solid-js";
+import NavLink from "../../components/NavLink";
+import { StoreContext } from "../../store";
+import type { Article } from "../../types";
+
+import Comments from "./Comments";
+
+// onDelete was a callback prop (handleDeleteArticle); a callback prop calling a context action is
+// refused (repro 11), so ArticleMeta deletes through the context action in its own click event.
+function ArticleMeta(props: { article?: Article; canModify: boolean; slug: string }) {
+  const [, { deleteArticle }] = useContext(StoreContext);
+  return (
+  <div class="article-meta">
+    <NavLink href={`@${props.article?.author.username}`} route="profile">
+      <img src={props.article?.author.image ?? undefined} alt="" />
+    </NavLink>
+
+    <div class="info">
+      <NavLink href={`@${props.article?.author.username}`} route="profile" class="author">
+        {props.article?.author.username}
+      </NavLink>
+      <span class="date">{new Date(props.article?.createdAt ?? NaN).toDateString()}</span>
+    </div>
+
+    <Show when={props.canModify} fallback={<span />}>
+      <span>
+        <NavLink
+          href={`editor/${props.article?.slug}`}
+          route="editor"
+          class="btn btn-outline-secondary btn-sm"
+        >
+          <i class="ion-edit" /> Edit Article
+        </NavLink>
+        <button
+          class="btn btn-outline-danger btn-sm"
+          onClick={() => {
+            const slug = props.slug;
+            // deleteArticle navigates home once the article is gone.
+            deleteArticle(slug);
+          }}
+        >
+          <i class="ion-trash-a" /> Delete Article
+        </button>
+      </span>
+    </Show>
+  </div>
+  );
+}
+
+export default function ArticlePage(props: { slug: string }) {
+  const [store] = useContext(StoreContext),
+    article = () => store.articles()[props.slug],
+    canModify = () => {
+      const user = store.currentUser();
+      return !!user && user.username === article()?.author.username;
+    },
+    body = () => {
+      const a = article();
+      return a ? marked(a.body, { sanitize: true }) : undefined;
+    };
+
+  return (
+    <div class="article-page">
+      <div class="banner">
+        <div class="container">
+          <h1>{article()?.title}</h1>
+          <ArticleMeta article={article()} canModify={canModify()} slug={props.slug} />
+        </div>
+      </div>
+
+      <div class="container page">
+        <div class="row article-content">
+          <div class="col-xs-12">
+            <div innerHTML={body()} />
+
+            <ul class="tag-list">
+              {article()?.tagList.map(tag => (
+                <li class="tag-default tag-pill tag-outline">{tag}</li>
+              ))}
+            </ul>
+          </div>
+        </div>
+
+        <hr />
+
+        <div class="article-actions" />
+
+        <div class="row">
+          <Comments />
+        </div>
+      </div>
+    </div>
+  );
+}
