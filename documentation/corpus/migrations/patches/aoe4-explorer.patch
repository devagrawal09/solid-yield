@@ -0,0 +1,33 @@
+// Compare two flow output dirs: node e2e/compare.mjs <dirA> <dirB>
+import fs from "node:fs";
+import path from "node:path";
+const [a, b] = process.argv.slice(2);
+const flows = ["home", "civ", "unit", "nav", "buildings", "search", ...(process.env.EXTRA?.split(",") ?? [])];
+let same = 0, diff = 0;
+for (const f of flows) {
+  const pa = path.join(a, f + ".json"), pb = path.join(b, f + ".json");
+  if (!fs.existsSync(pa) || !fs.existsSync(pb)) { console.log(`${f}: missing`); continue; }
+  // Solid 1 <A href="./x"> rendered "/civs/c/./x"; normalise "/./" so equal targets compare equal.
+  const norm = (s) => JSON.parse(JSON.stringify(s).replaceAll("/./", "/"));
+  const A = norm(JSON.parse(fs.readFileSync(pa, "utf8"))), B = norm(JSON.parse(fs.readFileSync(pb, "utf8")));
+  if (A.error || B.error) { console.log(`${f}: error A=${!!A.error} B=${!!B.error}`); diff++; continue; }
+  for (const k of ["toc", "toc2"]) if (k in A && JSON.stringify(A[k]) !== JSON.stringify(B[k])) { diff++; console.log(`${f}.${k}: ${A[k]?.length} vs ${B[k]?.length} entries; B=${JSON.stringify(B[k]).slice(0, 200)}`); }
+  A.steps.forEach((sa, i) => {
+    const sb = B.steps[i];
+    const out = [];
+    for (const k of ["url", "title"]) if (sa[k] !== sb[k]) out.push(`  ${k}: ${JSON.stringify(sa[k])} -> ${JSON.stringify(sb[k])}`);
+    const la = sa.text.split("\n"), lb = sb.text.split("\n");
+    if (sa.text !== sb.text) {
+      const sA = new Set(la), sB = new Set(lb);
+      const onlyA = la.filter((l) => !sB.has(l)), onlyB = lb.filter((l) => !sA.has(l));
+      out.push(`  text differs (${la.length} vs ${lb.length} lines); only in A: ${JSON.stringify(onlyA.slice(0, 8))}; only in B: ${JSON.stringify(onlyB.slice(0, 8))}`);
+      if (!onlyA.length && !onlyB.length) out.push("  (same lines, different order/duplicates)");
+    }
+    if (JSON.stringify(sa.links) !== JSON.stringify(sb.links)) {
+      const sA = new Set(sa.links), sB = new Set(sb.links);
+      out.push(`  links differ (${sa.links.length} vs ${sb.links.length}); only A: ${JSON.stringify(sa.links.filter((l) => !sB.has(l)).slice(0, 6))}; only B: ${JSON.stringify(sb.links.filter((l) => !sA.has(l)).slice(0, 6))}`);
+    }
+    if (out.length) { diff++; console.log(`${f}[${i}] ${sa.url}:\n${out.join("\n")}`); } else same++;
+  });
+}
+console.log(`identical steps: ${same}, differing steps: ${diff}`);
