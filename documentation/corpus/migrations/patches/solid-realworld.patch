+import { createEffect, createMemo, useContext } from "solid-js";
+import { StoreContext, RouterContext } from "../../store";
+import { predicateFor } from "./predicate";
+import Home from "./Home"; // was lazy() (repro 10)
+
+export default function HomeIndex() {
+  const [store, { loadArticles }] = useContext(StoreContext),
+    { location } = useContext(RouterContext),
+    tab = createMemo(() => {
+      const search = location().split("?")[1];
+      if (!search) return store.token() ? "feed" : "all";
+      const query = new URLSearchParams(search);
+      return query.get("tab");
+    });
+
+  // Was createComputed(() => loadArticles(getPredicate())): a write from a computation.
+  createEffect(
+    () => predicateFor(tab()),
+    predicate => {
+      loadArticles(predicate);
+    }
+  );
+
+  return <Home appName={store.appName} token={store.token()} tab={tab()} />;
