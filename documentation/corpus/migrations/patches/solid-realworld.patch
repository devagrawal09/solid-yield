+++ b/src/pages/Article/Comments.tsx
@@ -0,0 +1,132 @@
+import { createStore, Errored, For, Loading, Show, useContext } from "solid-js";
+import NavLink from "../../components/NavLink";
+import ListErrors from "../../components/ListErrors";
+import { StoreContext } from "../../store";
+import { isErrors, type Comment as CommentData, type Errors, type User } from "../../types";
+
+// onDelete used to come from Comments; a callback prop calling a context action is refused
+// (repro 11), so the comment deletes through the context.
+function Comment(props: { comment: CommentData; currentUser?: User }) {
+  const [, { deleteComment }] = useContext(StoreContext),
+    show = () => props.currentUser && props.currentUser.username === props.comment.author.username;
+  return (
+    <div class="card">
+      <div class="card-block">
+        <p class="card-text" textContent={props.comment.body} />
+      </div>
+      <div class="card-footer">
+        <NavLink href={`@${props.comment.author.username}`} route="profile" class="comment-author">
+          <img src={props.comment.author.image ?? undefined} class="comment-author-img" alt="" />
+        </NavLink>
+        &nbsp;
+        <NavLink href={`@${props.comment.author.username}`} route="profile" class="comment-author">
+          {props.comment.author.username}
+        </NavLink>
+        <span class="date-posted">{new Date(props.comment.createdAt).toDateString()}</span>
+        {show() && (
+          <span class="mod-options">
+            <i
+              class="ion-trash-a"
+              onClick={() => {
+                const id = props.comment.id;
+                deleteComment(id);
+              }}
+            />
+          </span>
+        )}
+      </div>
+    </div>
+  );
+}
+
+// createComment/loadComments were passed down as props; calling prop callbacks from the async
+// submit helper is refused, so CommentInput reads them from the context itself.
+function CommentInput(props: { slug?: string; currentUser: User }) {
+  const [, { createComment, loadComments }] = useContext(StoreContext),
+    [state, setState] = createStore<{ body: string; isCreatingComment?: boolean; errors?: Errors }>({
+      body: ""
+    }),
+    handleBodyChange = (ev: Event & { currentTarget: HTMLTextAreaElement }) => {
+      const body = ev.currentTarget.value;
+      setState(s => {
+        s.body = body;
+      });
+    },
+    createCommentHandler = async (ev: SubmitEvent) => {
+      ev.preventDefault();
+      setState(s => {
+        s.isCreatingComment = true;
+      });
+      try {
+        await createComment({ body: state.body });
+        setState(s => {
+          s.body = "";
+        });
+        const slug = String(props.slug);
+        loadComments(slug, true);
+      } catch (errors) {
+        setState(s => {
+          s.errors = isErrors(errors) ? errors : { error: [String(errors)] };
+        });
+      } finally {
+        setState(s => {
+          s.isCreatingComment = false;
+        });
+      }
+    };
+  return (
+    <>
+      <ListErrors errors={state.errors} />
+      <form class="card comment-form" onSubmit={createCommentHandler}>
+        <div class="card-block">
+          <textarea
+            class="form-control"
+            placeholder="Write a comment..."
+            value={state.body}
+            disabled={state.isCreatingComment}
+            onChange={handleBodyChange}
+            rows="3"
+          />
+        </div>
+        <div class="card-footer">
+          <img src={props.currentUser.image ?? undefined} class="comment-author-img" alt="" />
+          <button class="btn btn-sm btn-primary" type="submit">
+            Post Comment
+          </button>
+        </div>
+      </form>
+    </>
+  );
+}
+
+export default function Comments() {
+  const [store] = useContext(StoreContext);
+  return (
+    <div class="col-xs-12 col-md-8 offset-md-2">
+      <Show
+        when={store.currentUser()}
+        fallback={
+        <p>
+          <NavLink route="login">Sign in</NavLink>
+          &nbsp;or&nbsp;
+          <NavLink route="register">sign up</NavLink>
+          &nbsp;to add comments on this article.
+        </p>
+        }
+      >
+        {user => (
+          <CommentInput slug={store.articleSlug()} currentUser={user()} />
+        )}
+      </Show>
+      <Errored fallback="Could not load comments.">
+        <Loading fallback="Loading comments">
+          <For each={store.comments()}>
+            {comment => (
+              <Comment comment={comment} currentUser={store.currentUser()} />
+            )}
+          </For>
+        </Loading>
+      </Errored>
+    </div>
+  );
+}
