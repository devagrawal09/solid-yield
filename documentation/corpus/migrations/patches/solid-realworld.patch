--- /dev/null
+++ b/src/store/createAgent.ts
@@ -0,0 +1,102 @@
+import type { Article, ArticleDraft, Comment, Errors, Profile, User, UserUpdate } from "../types";
+
+const API_ROOT = "https://api.realworld.io/api";
+
+const encode = encodeURIComponent;
+
+export interface ArticlesPage {
+  articles: Article[];
+  articlesCount: number;
+}
+export type Result<K extends string, T> = { [P in K]: T } & { errors?: Errors };
+
+// `session` is a plain (non-reactive) mirror of the token: a Solid 1 resource fetcher read
+// state.token untracked; reading the token signal here would make every fetching memo depend on it.
+export default function createAgent(
+  session: { token: string | null | undefined },
+  setToken: (token: undefined) => void
+) {
+  async function send<T>(method: string, url: string, data?: unknown, resKey?: string): Promise<T> {
+    const headers: Record<string, string> = {},
+      opts: RequestInit = { method, headers };
+
+    if (data !== undefined) {
+      headers["Content-Type"] = "application/json";
+      opts.body = JSON.stringify(data);
+    }
+
+    if (session.token) headers["Authorization"] = `Token ${session.token}`;
+
+    try {
+      const response = await fetch(API_ROOT + url, opts);
+      const json = await response.json();
+      return resKey ? json[resKey] : json;
+    } catch (err) {
+      if (err && (err as { response?: Response }).response?.status === 401) {
+        session.token = undefined;
+        setToken(undefined);
+      }
+      // The original returns the error as the response value.
+      return err as T;
+    }
+  }
+
+  const Auth = {
+    current: () => send<User>("get", "/user", undefined, "user"),
+    login: (email: string, password: string) =>
+      send<Result<"user", User>>("post", "/users/login", { user: { email, password } }),
+    register: (username: string, email: string, password: string) =>
+      send<Result<"user", User>>("post", "/users", { user: { username, email, password } }),
+    save: (user: UserUpdate) => send<Result<"user", User>>("put", "/user", { user })
+  };
+
+  const Tags = {
+    getAll: () => send<string[]>("get", "/tags", undefined, "tags")
+  };
+
+  const limit = (count: number, p?: number) => `limit=${count}&offset=${p ? p * count : 0}`;
+  const omitSlug = (article: ArticleDraft) => Object.assign({}, article, { slug: undefined });
+
+  const Articles = {
+    all: (page: number, lim = 10) => send<ArticlesPage>("get", `/articles?${limit(lim, page)}`),
+    byAuthor: (author: string, page: number) =>
+      send<ArticlesPage>("get", `/articles?author=${encode(author)}&${limit(5, page)}`),
+    byTag: (tag: string, page: number, lim = 10) =>
+      send<ArticlesPage>("get", `/articles?tag=${encode(tag)}&${limit(lim, page)}`),
+    del: (slug: string) => send<{ errors?: Errors }>("delete", `/articles/${slug}`),
+    favorite: (slug: string) => send<Result<"article", Article>>("post", `/articles/${slug}/favorite`),
+    favoritedBy: (author: string, page: number) =>
+      send<ArticlesPage>("get", `/articles?favorited=${encode(author)}&${limit(5, page)}`),
+    feed: () => send<ArticlesPage>("get", "/articles/feed?limit=10&offset=0"),
+    get: (slug: string) => send<Article>("get", `/articles/${slug}`, undefined, "article"),
+    unfavorite: (slug: string) => send<Result<"article", Article>>("delete", `/articles/${slug}/favorite`),
+    update: (article: ArticleDraft) =>
+      send<Result<"article", Article>>("put", `/articles/${article.slug}`, { article: omitSlug(article) }),
+    create: (article: ArticleDraft) => send<Result<"article", Article>>("post", "/articles", { article })
+  };
+
+  const Comments = {
+    create: (slug: string, comment: { body: string }) =>
+      send<Result<"comment", Comment>>("post", `/articles/${slug}/comments`, { comment }),
+    delete: (slug: string, commentId: number) =>
+      send<{ errors?: Errors }>("delete", `/articles/${slug}/comments/${commentId}`),
+    forArticle: (slug: string) => send<Comment[]>("get", `/articles/${slug}/comments`, undefined, "comments")
+  };
+
+  const Profile = {
+    follow: (username: string) => send<Result<"profile", Profile>>("post", `/profiles/${username}/follow`),
+    get: (username: string) => send<Profile>("get", `/profiles/${username}`, undefined, "profile"),
+    unfollow: (username: string) =>
+      send<Result<"profile", Profile>>("delete", `/profiles/${username}/follow`)
+  };
+
+  return {
+    Articles,
+    Auth,
+    Comments,
+    Profile,
+    Tags
+  };
+}
+
+export type Agent = ReturnType<typeof createAgent>;
