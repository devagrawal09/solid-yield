+import { createEffect, createMemo } from "solid-js";
+import type { Accessor } from "solid-js";
+import type { Agent } from "./createAgent";
+
+export default function createCommon(agent: Agent, token: Accessor<string | null | undefined>) {
+  const tags = createMemo(() => agent.Tags.getAll().then(tags => tags.map(t => t.toLowerCase())));
