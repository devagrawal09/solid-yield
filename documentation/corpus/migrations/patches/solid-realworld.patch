@@ -0,0 +1,51 @@
+import { Errored, For, Loading, Show, useContext } from "solid-js";
+import { StoreContext } from "../store";
+import ArticlePreview from "./ArticlePreview";
+import type { Article, Predicate } from "../types";
+
+// The parents used to pass onSetPage (and this list passed onClickFavorite to each preview). A
+// callback prop that calls a context action is reported as a write in a reactive scope (repro 11),
+// so the list pages through the context itself; Home passes its predicate instead.
+export default function ArticleList(props: {
+  articles: Article[];
+  totalPagesCount: number;
+  currentPage?: number;
+  predicate?: Predicate;
+}) {
+  const [store, { setPage, loadArticles }] = useContext(StoreContext);
+  return (
+    // Errored added: the list memo can reject (the checker reported it unhandled at the root).
+    <Errored fallback={<div class="article-preview">Could not load articles.</div>}>
+      <Loading fallback={<div class="article-preview">Loading articles...</div>}>
+        <For
+          each={props.articles}
+          fallback={<div class="article-preview">No articles are here... yet.</div>}
+        >
+          {article => <ArticlePreview article={article} token={store.token()} />}
+        </For>
+        <Show when={props.totalPagesCount > 1}>
+          <nav>
+            <ul class="pagination">
+              <For each={[...Array(props.totalPagesCount).keys()]}>
+                {v => (
+                  <li
+                    class={["page-item", { active: props.currentPage === v }]}
+                    onClick={e => {
+                      e.preventDefault();
+                      const predicate = props.predicate;
+                      setPage(v);
+                      loadArticles(predicate);
+                      setTimeout(() => window.scrollTo(0, 0), 200);
+                    }}
+                  >
+                    <a class="page-link" href="" textContent={v + 1} />
+                  </li>
+                )}
+              </For>
+            </ul>
+          </nav>
+        </Show>
+      </Loading>
+    </Errored>
+  );
+}
