+import { createEffect, createStore, For, useContext } from "solid-js";
+import { StoreContext } from "../../store";
+import ListErrors from "../../components/ListErrors";
+import { isErrors, type ArticleDraft, type Errors } from "../../types";
+
+interface EditorState extends ArticleDraft {
+  tagInput: string;
+  inProgress?: boolean;
+  errors?: Errors;
+}
+type Field = "title" | "description" | "body" | "tagInput";
+
+export default function Editor(props: { slug?: string }) {
+  const [store, { createArticle, updateArticle }] = useContext(StoreContext),
+    [state, setState] = createStore<EditorState>({ tagInput: "", tagList: [] }),
+    updateState = (field: Field, ev: Event & { currentTarget: HTMLInputElement | HTMLTextAreaElement }) => {
+      const value = ev.currentTarget.value;
+      setState(s => {
+        s[field] = value;
+      });
+    },
+    handleAddTag = () => {
+      if (state.tagInput) {
+        setState(s => {
+          s.tagList.push(s.tagInput.trim());
+          s.tagInput = "";
+        });
+      }
+    },
+    handleRemoveTag = (tag: string) => {
+      !state.inProgress &&
+        setState(s => {
+          s.tagList = s.tagList.filter(t => t !== tag);
+        });
+    },
+    handleTagInputKeyDown = (ev: KeyboardEvent) => {
+      switch (ev.keyCode) {
+        case 13: // Enter
+        case 9: // Tab
+        case 188: // ,
+          if (ev.keyCode !== 9) ev.preventDefault();
+          handleAddTag();
+          break;
+        default:
+          break;
+      }
+    },
+    submitForm = async (ev: MouseEvent) => {
+      ev.preventDefault();
+      setState(s => {
+        s.inProgress = true;
+      });
+      // Was `const { inProgress, tagsInput, ...article } = state` (rest of a store, typed as its
+      // Source); the article fields are listed instead (tagInput and errors are no longer sent).
+      const article: ArticleDraft = {
+        slug: state.slug,
+        title: state.title,
+        description: state.description,
+        body: state.body,
+        tagList: [...state.tagList]
+      };
+      try {
+        const saved = props.slug ? await updateArticle(article) : await createArticle(article);
+        location.hash = `/article/${saved.slug}`;
+      } catch (errors) {
+        setState(s => {
+          s.errors = isErrors(errors) ? errors : { error: [String(errors)] };
+        });
+      } finally {
+        setState(s => {
+          s.inProgress = false;
+        });
+      }
+    };
+  // Was a createComputed that wrote the loaded article into the form state.
+  createEffect(
+    () => {
+      // Read once: the narrowing of a repeated props.slug read is lost in the lowering.
+      const slug = props.slug;
+      return slug ? store.articles()[slug] : undefined;
+    },
+    article => {
+      if (article)
+        setState(s => {
+          Object.assign(s, article, { tagList: [...article.tagList] });
+        });
+    }
+  );
+
+  return (
+    <div class="editor-page">
+      <div class="container page">
+        <div class="row">
+          <div class="col-md-10 offset-md-1 col-xs-12">
+            <ListErrors errors={state.errors} />
+            <form>
+              <fieldset>
+                <fieldset class="form-group">
+                  <input
+                    type="text"
+                    class="form-control form-control-lg"
+                    placeholder="Article Title"
+                    value={state.title}
+                    onChange={e => updateState("title", e)}
+                    disabled={state.inProgress}
+                  />
+                </fieldset>
+                <fieldset class="form-group">
+                  <input
+                    type="text"
+                    class="form-control"
+                    placeholder="What's this article about?"
+                    value={state.description}
+                    onChange={e => updateState("description", e)}
+                    disabled={state.inProgress}
+                  />
+                </fieldset>
+                <fieldset class="form-group">
+                  <textarea
+                    class="form-control"
+                    rows="8"
+                    placeholder="Write your article (in markdown)"
+                    value={state.body}
+                    onChange={e => updateState("body", e)}
+                    disabled={state.inProgress}
+                  ></textarea>
+                </fieldset>
+                <fieldset class="form-group">
+                  <input
+                    type="text"
+                    class="form-control"
+                    placeholder="Enter tags"
+                    value={state.tagInput}
+                    onChange={e => updateState("tagInput", e)}
+                    onBlur={handleAddTag}
+                    onKeyUp={handleTagInputKeyDown}
+                    disabled={state.inProgress}
+                  />
+                  <div class="tag-list">
+                    <For each={state.tagList}>
+                      {tag => (
+                        <span class="tag-default tag-pill">
+                          <i class="ion-close-round" onClick={() => handleRemoveTag(tag)} />
+                          {tag}
+                        </span>
+                      )}
+                    </For>
+                  </div>
+                </fieldset>
+                <button
+                  class="btn btn-lg pull-xs-right btn-primary"
+                  type="button"
+                  disabled={state.inProgress}
+                  onClick={submitForm}
+                >
+                  Publish Article
+                </button>
+              </fieldset>
+            </form>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
