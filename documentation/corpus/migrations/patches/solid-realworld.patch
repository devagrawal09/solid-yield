@@ -0,0 +1,26 @@
+import { createEffect, useContext } from "solid-js";
+import { StoreContext, RouterContext } from "../../store";
+import Profile from "./Profile"; // was lazy() (repro 10)
+
+export default function ProfileIndex(props: { params: (string | undefined)[]; routeName: string }) {
+  const [, { loadProfile, loadArticles }] = useContext(StoreContext),
+    { location } = useContext(RouterContext);
+  // Both were createComputed calls that wrote the store's sources.
+  createEffect(
+    () => (props.routeName === "profile" ? props.params[0] : undefined),
+    username => {
+      if (username) loadProfile(username);
+    }
+  );
+  createEffect(
+    () => {
+      if (props.routeName !== "profile") return undefined;
+      const username = props.params[0];
+      return location().includes("/favorites") ? { favoritedBy: username } : { author: username };
+    },
+    predicate => {
+      if (predicate) loadArticles(predicate);
+    }
+  );
+  return <Profile username={props.params[0] ?? ""} />;
+}
