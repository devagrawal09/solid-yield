+import type { Predicate } from "../../types";
+
+export function predicateFor(tab: string | null | undefined): Predicate | undefined {
+  switch (tab) {
+    case "feed":
+      return { myFeed: true };
+    case "all":
+      return {};
+    case undefined:
+      return undefined;
+    default:
+      return { tag: tab ?? undefined };
+  }
+}
