+function App() {
+  const cart = makeCart();
+  return (
+    <CartCtx value={cart}>
+      <Clock />
+      <Errored fallback={(e: unknown) => <p>failed {`${e}`}</p>}>
+        <Loading fallback={<p>loading</p>}>
+          <ProductList />
+          <Details id="1" />
+        </Loading>
+      </Errored>
+      <Loading fallback={<p>loading</p>}><Checkout /></Loading>
+    </CartCtx>
+  );
+}
+render(() => <App />, document.getElementById("root")!);
