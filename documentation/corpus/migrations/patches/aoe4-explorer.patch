+// Debug helper: node e2e/debug.mjs <baseUrl> <path> [clickSelector...]  — prints console/page errors with stacks.
+import { chromium } from "playwright-core";
+const [base, path, ...clicks] = process.argv.slice(2);
+const browser = await chromium.launch({ executablePath: "/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell" });
+const page = await browser.newPage({ viewport: { width: 1600, height: 1000 } });
+page.on("console", (m) => ["error", "warning"].includes(m.type()) && !m.text().startsWith("Failed to load") && console.log(`[console.${m.type()}]`, m.text().slice(0, 1500)));
+page.on("pageerror", (e) => console.log("[pageerror]", e.stack?.slice(0, 2500)));
+await page.route("**/*", (r) => (r.request().url().startsWith(base) ? r.continue() : r.request().url().includes("curated") ? r.fulfill({ body: "[]", contentType: "application/json" }) : r.abort()));
+await page.goto(base + path);
+await page.waitForTimeout(2500);
+for (const sel of clicks) {
+  console.log("--- click", sel);
+  if (sel.startsWith("type:")) await page.keyboard.type(sel.slice(5), { delay: 30 });
+  else if (sel.startsWith("key:")) await page.keyboard.press(sel.slice(4));
+  else await page.locator(sel).first().click();
+  await page.waitForTimeout(2500);
+}
+console.log("URL", page.url(), "TITLE", await page.title());
+console.log((await page.locator("#root").innerText()).replace(/\s+/g, " ").slice(0, 600));
+await browser.close();
diff --git a/e2e/flows.mjs b/e2e/flows.mjs
new file mode 100644
index 0000000..4a16a9f
--- /dev/null
+++ b/e2e/flows.mjs
@@ -0,0 +1,151 @@
+// Key user flows for the explorer. Usage: node e2e/flows.mjs <baseUrl> <outDir>
+// External hosts are mocked: curated content -> e2e/content.json, data.aoe4world.com/images -> data/images, fontawesome kit / everything else -> aborted.
+import { chromium } from "playwright-core";
+import fs from "node:fs";
+import path from "node:path";
+
+const [base = "http://localhost:4173", outDir = "e2e/out"] = process.argv.slice(2);
+fs.mkdirSync(outDir, { recursive: true });
+const only = process.env.FLOWS?.split(",");
+const CONTENT = fs.readFileSync(new URL("./content.json", import.meta.url), "utf8");
+const DATA_IMAGES = path.resolve(new URL("..", import.meta.url).pathname, "data/images");
+
+const browser = await chromium.launch({
+  executablePath: "/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell",
+});
+
+async function newPage() {
+  const context = await browser.newContext({ viewport: { width: 1600, height: 1000 } });
+  const page = await context.newPage();
+  const log = [];
+  const aborted = new Set();
+  page.on("console", (m) => (m.type() === "error" || m.type() === "warning") && !m.text().startsWith("Failed to load resource") && log.push(`[console.${m.type()}] ${m.text().slice(0, 300)}`));
+  page.on("pageerror", (e) => log.push(`[pageerror] ${String(e.message).slice(0, 300)}`));
+  await page.route("**/*", (route) => {
+    const url = route.request().url();
+    if (url.startsWith(base)) return route.continue();
+    if (url.startsWith("https://curated.aoe4world.com/")) return route.fulfill({ status: 200, contentType: "application/json", body: CONTENT });
+    if (url.startsWith("https://data.aoe4world.com/images/")) {
+      const file = path.join(DATA_IMAGES, decodeURIComponent(new URL(url).pathname.slice("/images/".length)));
+      if (file.startsWith(DATA_IMAGES) && fs.existsSync(file)) return route.fulfill({ path: file });
+    }
+    aborted.add(new URL(url).host);
+    return route.abort();
+  });
+  return { page, log, aborted };
+}
+
+async function snap(page) {
+  return page.evaluate(() => {
+    const root = document.querySelector("#root");
+    const text = (root?.innerText ?? "").replace(/[ \t]+/g, " ").replace(/\n\s*\n+/g, "\n").trim();
+    const links = [...(root?.querySelectorAll("a[href]") ?? [])].map((a) => a.getAttribute("href"));
+    return { url: location.pathname + location.search, title: document.title, text, links };
+  });
+}
+
+async function settle(page, ms = 600) {
+  await page.waitForLoadState("networkidle").catch(() => {});
+  await page.waitForTimeout(ms);
+}
+
+const flows = {
+  // 1. Landing page: civ list
+  async home({ page }) {
+    await page.goto(base + "/");
+    await page.getByRole("heading", { name: "AoE4 Explorer" }).waitFor({ timeout: 15000 });
+    await settle(page);
+    return { steps: [await snap(page)] };
+  },
+  // 2. Civ detail page: header, unique items, unit + building cards
+  async civ({ page }) {
+    await page.goto(base + "/civs/english");
+    await page.getByRole("heading", { name: "English", exact: true }).waitFor({ timeout: 15000 });
+    await page.getByText("Hitpoints").first().waitFor({ timeout: 15000 });
+    await settle(page);
+    return { steps: [await snap(page)] };
+  },
+  // 3. Unit detail page, then switch the age tab to II
+  async unit({ page }) {
+    await page.goto(base + "/civs/english/units/longbowman");
+    await page.getByText("Line of Sight").first().waitFor({ timeout: 15000 });
+    await settle(page);
+    const first = await snap(page);
+    await page.getByRole("button", { name: "II", exact: true }).click();
+    await settle(page);
+    return { steps: [first, await snap(page)] };
+  },
+  // 4. Client-side navigation: home -> civ -> unit card -> toolbar home
+  async nav({ page }) {
+    await page.goto(base + "/");
+    await page.getByRole("heading", { name: "AoE4 Explorer" }).waitFor({ timeout: 15000 });
+    await page.locator('#root a[href="/civs/french"]').first().click();
+    await page.getByRole("heading", { name: "French", exact: true }).waitFor({ timeout: 15000 });
+    await page.getByText("Hitpoints").first().waitFor({ timeout: 15000 });
+    await settle(page);
+    const civ = await snap(page);
+    await page.locator('#root a[href="/civs/french/units/royal-knight"]').first().click();
+    await page.getByText("Line of Sight").first().waitFor({ timeout: 15000 });
+    await settle(page);
+    const unit = await snap(page);
+    return { steps: [civ, unit] };
+  },
+  // 5. Buildings overview and a technology detail page
+  async buildings({ page }) {
+    await page.goto(base + "/buildings");
+    await page.getByText("Archery Range").first().waitFor({ timeout: 15000 });
+    await settle(page);
+    const overview = await snap(page);
+    await page.goto(base + "/technologies/wheelbarrow");
+    await page.getByRole("heading", { name: "Wheelbarrow" }).first().waitFor({ timeout: 15000 });
+    await settle(page);
+    return { steps: [overview, await snap(page)] };
+  },
+  // 6. Toolbar search: type, see results, Enter navigates to first result
+  async search({ page }) {
+    await page.goto(base + "/");
+    await page.getByRole("heading", { name: "AoE4 Explorer" }).waitFor({ timeout: 15000 });
+    const input = page.getByPlaceholder("Search...");
+    await input.click();
+    await input.pressSequentially("longbow", { delay: 30 });
+    await page.locator("a.selected").first().waitFor({ timeout: 15000 });
+    await settle(page, 300);
+    const results = await snap(page);
+    await input.press("Enter");
+    await page.getByText("Line of Sight").first().waitFor({ timeout: 15000 });
+    await settle(page);
+    return { steps: [results, await snap(page)] };
+  },
+  // 7. Patch notes page: table-of-contents sidebar ("Jump to") filled by heading anchors, then civ filter
+  async patch({ page }) {
+    await page.goto(base + "/patches/patch-16-1-9737-season-13");
+    await page.getByRole("heading", { name: /Season 13 Update/ }).first().waitFor({ timeout: 15000 });
+    await settle(page);
+    const all = await snap(page);
+    const toc = await page.evaluate(() => [...document.querySelectorAll('a[target="_self"][href^="#"]')].map((a) => a.textContent));
+    // filter row: "All", then one flag per civ in CIVILIZATIONS order (ab, ay, by, ch, de, en, ...): English is the 7th anchor
+    await page.getByText("Filter updates by civilization").locator("xpath=following-sibling::div[1]/a").nth(6).click();
+    await settle(page);
+    const toc2 = await page.evaluate(() => [...document.querySelectorAll('a[target="_self"][href^="#"]')].map((a) => a.textContent));
+    return { steps: [all, await snap(page)], toc, toc2 };
+  },
+};
+
+const summary = {};
+for (const [name, flow] of Object.entries(flows)) {
+  if (only && !only.includes(name)) continue;
+  const ctx = await newPage();
+  const t0 = Date.now();
+  try {
+    const result = await flow(ctx);
+    summary[name] = { ok: true, ms: Date.now() - t0, log: ctx.log, aborted: [...ctx.aborted] };
+    fs.writeFileSync(path.join(outDir, `${name}.json`), JSON.stringify(result, null, 2));
+  } catch (e) {
+    summary[name] = { ok: false, ms: Date.now() - t0, error: String(e.message).split("\n")[0], log: ctx.log, aborted: [...ctx.aborted] };
+    fs.writeFileSync(path.join(outDir, `${name}.json`), JSON.stringify({ error: String(e), partial: await snap(ctx.page).catch(() => null) }, null, 2));
+  }
+  await ctx.page.context().close();
+  console.log(`${summary[name].ok ? "PASS" : "FAIL"} ${name} (${summary[name].ms} ms)${summary[name].error ? " " + summary[name].error : ""}`);
+}
+fs.writeFileSync(path.join(outDir, "summary.json"), JSON.stringify(summary, null, 2));
+await browser.close();
diff --git a/e2e/serve.mjs b/e2e/serve.mjs
new file mode 100644
index 0000000..ce801bc
--- /dev/null
+++ b/e2e/serve.mjs
@@ -0,0 +1,16 @@
+// Tiny static server with SPA fallback: node e2e/serve.mjs <distDir> <port>
+import http from "node:http";
+import fs from "node:fs";
+import path from "node:path";
+const [dir, port = "4173"] = process.argv.slice(2);
+const root = path.resolve(dir);
+const types = { ".html": "text/html", ".js": "text/javascript", ".css": "text/css", ".json": "application/json", ".png": "image/png", ".webp": "image/webp", ".svg": "image/svg+xml", ".jpg": "image/jpeg", ".ico": "image/x-icon" };
+http
+  .createServer((req, res) => {
+    const url = decodeURIComponent(new URL(req.url, "http://x").pathname);
+    let file = path.join(root, url);
+    if (!file.startsWith(root) || !fs.existsSync(file) || fs.statSync(file).isDirectory()) file = path.join(root, "index.html");
+    res.writeHead(200, { "content-type": types[path.extname(file)] ?? "application/octet-stream" });
+    fs.createReadStream(file).pipe(res);
+  })
+  .listen(Number(port), () => console.log(`serving ${root} on ${port}`));
