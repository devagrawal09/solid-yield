@@ -0,0 +1,255 @@
+// Drives the key RealWorld flows against a served build with a mocked API.
+// usage: node e2e/flows.mjs <baseUrl> <outDir>
+import { createRequire } from "node:module";
+import { mkdirSync, writeFileSync } from "node:fs";
+import { createMockApi } from "./mock-api.mjs";
+
+const require = createRequire("/opt/node-tools/node_modules/");
+const { chromium } = require("playwright-core");
+
+const [base = "http://127.0.0.1:5000", out = "e2e/out"] = process.argv.slice(2);
+mkdirSync(out, { recursive: true });
+
+const snapFn = () => {
+  const t = s => [...document.querySelectorAll(s)].map(e => e.textContent.trim().replace(/\s+/g, " "));
+  const v = s => [...document.querySelectorAll(s)].map(e => e.value);
+  return {
+    hash: location.hash,
+    nav: t("nav.navbar .nav-link"),
+    navActive: t("nav.navbar .nav-link.active"),
+    feedTabs: t(".feed-toggle .nav-link"),
+    feedActive: t(".feed-toggle .nav-link.active"),
+    previews: t(".article-preview h1"),
+    previewMeta: t(".article-preview .info"),
+    previewFav: t(".article-preview .pull-xs-right button"),
+    previewTags: t(".article-preview .tag-list"),
+    previewPlaceholder: t(".article-preview:not(:has(h1))"),
+    pages: t(".pagination .page-item"),
+    pageActive: t(".pagination .page-item.active"),
+    tags: t(".sidebar .tag-pill"),
+    articleTitle: t(".article-page .banner h1"),
+    articleMeta: t(".article-page .banner .article-meta"),
+    articleBody: document.querySelector(".article-content .col-xs-12 > div")?.innerHTML ?? null,
+    articleTags: t(".article-content .tag-list li"),
+    commentForm: document.querySelectorAll(".comment-form").length,
+    comments: t(".card:not(.comment-form) .card-text"),
+    commentDelete: document.querySelectorAll(".mod-options").length,
+    errors: t(".error-messages li"),
+    profile: t(".user-info h4"),
+    profileBio: t(".user-info p"),
+    profileBtns: t(".user-info .action-btn"),
+    articlesToggle: t(".articles-toggle .nav-link"),
+    articlesToggleActive: t(".articles-toggle .nav-link.active"),
+    editorTags: t(".editor-page .tag-list .tag-pill"),
+    inputs: v("form input, form textarea"),
+    text: document.body.innerText.replace(/\s+/g, " ").trim()
+  };
+};
+
+// Fault-injection flows (not in the original baseline set): failures and pending at the root.
+const faults = {
+  failtags: [{ match: /^GET \/tags/, abort: true }],
+  faillist: [{ match: /^GET \/articles\?/, status: 500 }],
+  failarticle: [{ match: /^GET \/articles\/how-to-train-your-dragon$/, abort: true }],
+  failfollow: [{ match: /^POST \/profiles\/alice\/follow/, abort: true }],
+  pending: [{ match: /^GET \/user$/, delay: 1500 }],
+  pendinglist: [{ match: /^GET \/articles\?/, delay: 1500 }],
+  pendingtags: [{ match: /^GET \/tags/, delay: 1500 }]
+};
+
+const flows = {
+  async home(page, s) {
+    await page.goto(`${base}/#/`);
+    await page.waitForSelector(".article-preview h1");
+    await page.waitForSelector(".sidebar .tag-pill");
+    await s("p1");
+    await page.click(".pagination .page-item:nth-child(2) a");
+    await page.waitForFunction(() => [...document.querySelectorAll(".article-preview h1")].some(e => e.textContent.includes("number 11")));
+    await s("p2");
+  },
+  async tag(page, s) {
+    await page.goto(`${base}/#/`);
+    await page.waitForSelector(".sidebar .tag-pill");
+    await page.click(".sidebar .tag-pill >> text=training");
+    await page.waitForFunction(() => {
+      const h = [...document.querySelectorAll(".article-preview h1")];
+      return h.length === 1 && h[0].textContent.includes("dragon");
+    });
+    await s("training");
+  },
+  async article(page, s) {
+    await page.goto(`${base}/#/`);
+    await page.waitForSelector(".article-preview h1");
+    await page.click(".article-preview .preview-link >> nth=0");
+    await page.waitForFunction(() => document.querySelector(".article-page .banner h1")?.textContent.includes("dragon"));
+    await page.waitForFunction(() => document.querySelectorAll(".card .card-text").length >= 2);
+    await s("anon");
+  },
+  async login(page, s) {
+    await page.goto(`${base}/#/login`);
+    await page.waitForSelector(".auth-page form");
+    await fill(page, "input[placeholder=Email]", "jake@example.com");
+    await fill(page, "input[placeholder=Password]", "wrong");
+    await page.click(".auth-page button[type=submit]");
+    await page.waitForSelector(".error-messages li");
+    await s("error");
+    await fill(page, "input[placeholder=Password]", "secret");
+    await page.click(".auth-page button[type=submit]");
+    await page.waitForFunction(() => document.querySelector("nav.navbar")?.textContent.includes("jake"));
+    await page.waitForSelector(".article-preview h1");
+    await s("home");
+  },
+  async profile(page, s) {
+    await page.goto(`${base}/#/@alice`);
+    await page.waitForFunction(() => document.querySelector(".user-info p")?.textContent.includes("dragons"));
+    await page.waitForSelector(".article-preview h1");
+    await s("mine");
+    await page.click(".articles-toggle .nav-link >> text=Favorited");
+    await page.waitForFunction(() => location.hash.includes("favorites"));
+    await page.waitForFunction(() => {
+      const h = [...document.querySelectorAll(".article-preview h1")].map(e => e.textContent);
+      return h.length === 2 && h.every(x => /number (3|6)/.test(x));
+    });
+    await s("favorites");
+  },
+  async authed(page, s, ctx) {
+    await ctx.addInitScript(() => localStorage.setItem("jwt", "jwt-jake"));
+    await page.goto(`${base}/#/article/how-to-train-your-dragon`);
+    await page.waitForFunction(() => document.querySelector("nav.navbar")?.textContent.includes("jake"));
+    await page.waitForFunction(() => document.querySelectorAll(".card:not(.comment-form) .card-text").length >= 2);
+    await s("article");
+    await fill(page, ".comment-form textarea", "A new comment");
+    await page.click(".comment-form button[type=submit]");
+    await page.waitForFunction(() => document.querySelectorAll(".card:not(.comment-form) .card-text").length === 3);
+    await s("commented");
+    await page.dispatchEvent(".mod-options i >> nth=0", "click"); // icon has no box (icon font blocked)
+    await page.waitForFunction(() => document.querySelectorAll(".card:not(.comment-form) .card-text").length === 2);
+    await s("deleted");
+    await page.click("nav.navbar .nav-link >> text=New Post");
+    await page.waitForSelector(".editor-page input[placeholder='Article Title']");
+    await fill(page, "input[placeholder='Article Title']", "Fresh post");
+    await fill(page, "input[placeholder=\"What's this article about?\"]", "About fresh");
+    await fill(page, "textarea[placeholder^='Write your article']", "Some *body*");
+    await fill(page, "input[placeholder='Enter tags']", "newtag");
+    await page.press("input[placeholder='Enter tags']", "Enter");
+    await page.waitForTimeout(300); // Solid 1 original: tag pill never renders (setState mutator), so do not wait on it
+    await s("editor");
+    await page.click(".editor-page button >> text=Publish Article");
+    await page.waitForFunction(() => location.hash === "#/article/fresh-post");
+    await page.waitForFunction(() => document.querySelector(".article-page .banner h1")?.textContent.includes("Fresh post"));
+    await s("published");
+    await page.click("nav.navbar .nav-link >> text=Settings");
+    await page.waitForSelector(".settings-page form");
+    await s("settings");
+    await page.click(".settings-page .btn-outline-danger");
+    await page.waitForFunction(() => document.querySelector("nav.navbar")?.textContent.includes("Sign in"));
+    await page.waitForSelector(".article-preview h1");
+    await s("loggedout");
+  },
+  async failtags(page, s) {
+    await page.goto(`${base}/#/`);
+    await page.waitForSelector(".article-preview h1");
+    await page.waitForTimeout(800);
+    await s("home");
+  },
+  async faillist(page, s) {
+    await page.goto(`${base}/#/`);
+    await page.waitForSelector(".sidebar .tag-pill");
+    await page.waitForTimeout(800);
+    await s("home");
+  },
+  async failarticle(page, s) {
+    await page.goto(`${base}/#/article/how-to-train-your-dragon`);
+    await page.waitForTimeout(1200);
+    await s("article");
+  },
+  async failfollow(page, s, ctx) {
+    await ctx.addInitScript(() => localStorage.setItem("jwt", "jwt-jake"));
+    await page.goto(`${base}/#/@alice`);
+    await page.waitForSelector(".user-info .action-btn");
+    await page.click(".user-info .action-btn");
+    await page.waitForTimeout(800);
+    await s("clicked");
+  },
+  async pending(page, s, ctx) {
+    await ctx.addInitScript(() => localStorage.setItem("jwt", "jwt-jake"));
+    await page.goto(`${base}/#/`);
+    await page.waitForTimeout(400);
+    await s("waiting");
+    await page.waitForFunction(() => document.querySelector("nav.navbar")?.textContent.includes("jake"), null, { timeout: 8000 });
+    await page.waitForSelector(".article-preview h1");
+    await s("loaded");
+  },
+  async pendinglist(page, s) {
+    await page.goto(`${base}/#/`);
+    await page.waitForTimeout(500);
+    await s("waiting");
+    await page.waitForSelector(".article-preview h1", { timeout: 8000 });
+    await s("loaded");
+  },
+  async pendingtags(page, s) {
+    await page.goto(`${base}/#/`);
+    await page.waitForTimeout(500);
+    await s("waiting");
+    await page.waitForSelector(".sidebar .tag-pill", { timeout: 8000 });
+    await s("loaded");
+  },
+  async favorite(page, s, ctx) {
+    await ctx.addInitScript(() => localStorage.setItem("jwt", "jwt-jake"));
+    await page.goto(`${base}/#/@alice`);
+    await page.waitForFunction(() => document.querySelector("nav.navbar")?.textContent.includes("jake"));
+    await page.waitForSelector(".user-info .action-btn");
+    await page.waitForSelector(".article-preview h1");
+    await s("profile");
+    await page.click(".user-info .action-btn");
+    await page.waitForFunction(() => document.querySelector(".user-info .action-btn")?.textContent.includes("Unfollow"));
+    await s("followed");
+    await page.click(".article-preview .pull-xs-right button >> nth=0");
+    await page.waitForTimeout(500);
+    await s("favclick");
+  }
+};
+
+async function fill(page, sel, value) {
+  await page.fill(sel, value);
+  await page.dispatchEvent(sel, "change");
+}
+
+const browser = await chromium.launch({ executablePath: "/opt/pw-browsers/chromium-1194/chrome-linux/chrome" });
+const only = process.env.FLOWS ? process.env.FLOWS.split(",") : Object.keys(flows).filter(f => !faults[f]);
+const summary = {};
+for (const name of only) {
+  const ctx = await browser.newContext();
+  const api = createMockApi({ faults: faults[name] ?? [] });
+  await api.install(ctx);
+  const page = await ctx.newPage();
+  const errors = [];
+  page.on("pageerror", e => errors.push(`pageerror: ${e.message}`));
+  const warnings = [];
+  page.on("console", m => {
+    if (m.type() === "error") errors.push(`console: ${m.text()}`);
+    else if (m.type() === "warning") warnings.push(m.text().slice(0, 300));
+  });
+  page.setDefaultTimeout(8000);
+  const steps = [];
+  const s = async step => {
+    await page.waitForTimeout(name.startsWith("pending") && step === "waiting" ? 0 : 300);
+    const snap = await page.evaluate(snapFn);
+    writeFileSync(`${out}/${name}-${step}.json`, JSON.stringify(snap, null, 2));
+    writeFileSync(`${out}/${name}-${step}.html`, await page.evaluate(() => document.body.innerHTML));
+    steps.push(step);
+  };
+  let status = "pass", failure;
+  try {
+    await flows[name](page, s, ctx);
+  } catch (e) {
+    status = "fail";
+    failure = e.message.split("\n")[0];
+    try { await s("FAILED"); } catch {}
+  }
+  summary[name] = { status, steps, failure, errors, warnings, api: api.log };
+  console.log(`${status.toUpperCase()} ${name} [${steps.join(",")}]${failure ? " :: " + failure : ""}${errors.length ? " errors=" + errors.length : ""}${warnings.length ? " warnings=" + warnings.length : ""}`);
+  await ctx.close();
+}
+writeFileSync(`${out}/summary.json`, JSON.stringify(summary, null, 2));
+await browser.close();
diff --git a/e2e/mock-api.mjs b/e2e/mock-api.mjs
new file mode 100644
index 0000000..bcfc81b
--- /dev/null
+++ b/e2e/mock-api.mjs
@@ -0,0 +1,183 @@
+// Stateful mock of the RealWorld API (https://api.realworld.io/api), used by flows.mjs
+// through Playwright's page.route. One instance per browser context.
+const API = "https://api.realworld.io/api";
+
+const seedUsers = () => ({
+  jake: { username: "jake", email: "jake@example.com", bio: "I work at statefarm", image: "img/jake.png", token: "jwt-jake" }
+});
+const seedProfiles = () => ({
+  alice: { username: "alice", bio: "Alice writes about dragons", image: "img/alice.png", following: false },
+  bob: { username: "bob", bio: null, image: "img/bob.png", following: true },
+  jake: { username: "jake", bio: "I work at statefarm", image: "img/jake.png", following: false }
+});
+
+function makeArticles(profiles) {
+  const out = [];
+  for (let i = 1; i <= 12; i++) {
+    const author = i % 3 === 0 ? "bob" : "alice";
+    out.push({
+      slug: i === 1 ? "how-to-train-your-dragon" : `article-${i}`,
+      title: i === 1 ? "How to train your dragon" : `Article number ${i}`,
+      description: i === 1 ? "Ever wonder how?" : `Description ${i}`,
+      body: i === 1 ? "# Dragons\n\nIt takes a **Jacobian**.\n\n- one\n- two" : `Body of article ${i}`,
+      tagList: i === 1 ? ["dragons", "training"] : i % 2 === 0 ? ["welcome"] : ["solid", "welcome"],
+      createdAt: new Date(Date.UTC(2021, 0, 13 - i, 12)).toISOString(),
+      updatedAt: new Date(Date.UTC(2021, 0, 13 - i, 12)).toISOString(),
+      favorited: i === 2,
+      favoritesCount: i === 2 ? 3 : i,
+      author: { ...profiles[author] }
+    });
+  }
+  return out;
+}
+
+// faults: [{ match: RegExp on "METHOD /path?query", abort?: true, status?: number, delay?: ms }]
+export function createMockApi({ delay = 30, faults = [] } = {}) {
+  // Fresh state per browser context (flows must not see each other's follows/registrations).
+  const users = seedUsers(), profiles = seedProfiles();
+  const articles = makeArticles(profiles);
+  const comments = {
+    "how-to-train-your-dragon": [
+      { id: 1, body: "It takes a Jacobian", createdAt: "2021-01-14T10:00:00.000Z", author: { ...profiles.bob } },
+      { id: 2, body: "Jake was here", createdAt: "2021-01-15T10:00:00.000Z", author: { ...profiles.jake } }
+    ]
+  };
+  let nextComment = 3;
+  const favoritedBy = { jake: new Set(["article-2"]), alice: new Set(["article-3", "article-6"]) };
+  const log = [];
+
+  const view = (a, viewer) => ({ ...a, favorited: viewer ? favoritedBy[viewer]?.has(a.slug) || false : false });
+
+  function handle(method, url, body, auth) {
+    const u = new URL(url);
+    const path = u.pathname.replace(/^\/api/, "");
+    const q = u.searchParams;
+    const viewer = auth ? Object.values(users).find(x => `Token ${x.token}` === auth)?.username : undefined;
+    const page = list => {
+      const limit = +(q.get("limit") || 10), offset = +(q.get("offset") || 0);
+      return { articles: list.slice(offset, offset + limit).map(a => view(a, viewer)), articlesCount: list.length };
+    };
+    let m;
+    if (method === "GET" && path === "/tags") return [200, { tags: ["Dragons", "training", "welcome", "solid"] }];
+    if (method === "GET" && path === "/articles/feed") return [200, page(articles.filter(a => a.author.username === "bob"))];
+    if (method === "GET" && path === "/articles") {
+      let list = articles;
+      if (q.get("tag")) list = list.filter(a => a.tagList.includes(q.get("tag")));
+      if (q.get("author")) list = list.filter(a => a.author.username === q.get("author"));
+      if (q.get("favorited")) list = list.filter(a => favoritedBy[q.get("favorited")]?.has(a.slug));
+      return [200, page(list)];
+    }
+    if (method === "POST" && path === "/articles") {
+      const a = body.article;
+      if (!a.title) return [422, { errors: { title: ["can't be blank"] } }];
+      const slug = a.title.toLowerCase().replace(/[^a-z0-9]+/g, "-");
+      const art = {
+        slug, title: a.title, description: a.description || "", body: a.body || "", tagList: a.tagList || [],
+        createdAt: "2021-02-01T12:00:00.000Z", updatedAt: "2021-02-01T12:00:00.000Z",
+        favorited: false, favoritesCount: 0, author: { ...profiles[viewer || "jake"] }
+      };
+      articles.unshift(art);
+      return [200, { article: art }];
+    }
+    if ((m = path.match(/^\/articles\/([^/]+)\/comments$/))) {
+      const slug = m[1];
+      if (method === "GET") return [200, { comments: comments[slug] || [] }];
+      if (method === "POST") {
+        if (!body.comment.body) return [422, { errors: { body: ["can't be blank"] } }];
+        const c = { id: nextComment++, body: body.comment.body, createdAt: "2021-02-02T10:00:00.000Z", author: { ...profiles[viewer] } };
+        (comments[slug] ||= []).push(c);
+        return [200, { comment: c }];
+      }
+    }
+    if ((m = path.match(/^\/articles\/([^/]+)\/comments\/(\d+)$/)) && method === "DELETE") {
+      comments[m[1]] = (comments[m[1]] || []).filter(c => c.id !== +m[2]);
+      return [200, {}];
+    }
+    if ((m = path.match(/^\/articles\/([^/]+)\/favorite$/))) {
+      const a = articles.find(x => x.slug === m[1]);
+      const set = (favoritedBy[viewer] ||= new Set());
+      if (method === "POST" && !set.has(a.slug)) { set.add(a.slug); a.favoritesCount++; }
+      if (method === "DELETE" && set.has(a.slug)) { set.delete(a.slug); a.favoritesCount--; }
+      return [200, { article: view(a, viewer) }];
+    }
+    if ((m = path.match(/^\/articles\/([^/]+)$/))) {
+      const idx = articles.findIndex(x => x.slug === m[1]);
+      if (idx < 0) return [404, { errors: { article: ["not found"] } }];
+      if (method === "GET") return [200, { article: view(articles[idx], viewer) }];
+      if (method === "PUT") {
+        Object.assign(articles[idx], Object.fromEntries(Object.entries(body.article).filter(([, v]) => v !== undefined)));
+        return [200, { article: view(articles[idx], viewer) }];
+      }
+      if (method === "DELETE") { articles.splice(idx, 1); return [200, {}]; }
+    }
+    if ((m = path.match(/^\/profiles\/([^/]+)(\/follow)?$/))) {
+      const p = profiles[m[1]];
+      if (!p) return [404, { errors: { profile: ["not found"] } }];
+      if (m[2]) p.following = method === "POST";
+      return [200, { profile: { ...p } }];
+    }
+    if (method === "POST" && path === "/users/login") {
+      const { email, password } = body.user;
+      const user = Object.values(users).find(x => x.email === email);
+      if (!user || password !== "secret") return [422, { errors: { "email or password": ["is invalid"] } }];
+      return [200, { user }];
+    }
+    if (method === "POST" && path === "/users") {
+      const { username, email } = body.user;
+      if (users[username]) return [422, { errors: { username: ["has already been taken"] } }];
+      const user = { username, email, bio: null, image: null, token: `jwt-${username}` };
+      users[username] = user;
+      profiles[username] = { username, bio: null, image: null, following: false };
+      return [200, { user }];
+    }
+    if (path === "/user") {
+      if (!viewer) return [401, { errors: { token: ["is missing"] } }];
+      if (method === "GET") return [200, { user: users[viewer] }];
+      if (method === "PUT") {
+        Object.assign(users[viewer], body.user);
+        Object.assign(profiles[viewer], { bio: users[viewer].bio, image: users[viewer].image });
+        return [200, { user: users[viewer] }];
+      }
+    }
+    return [404, { errors: { route: [`${method} ${path} not mocked`] } }];
+  }
+
+  async function install(context) {
+    await context.route("**/*", async route => {
+      const req = route.request();
+      const url = req.url();
+      if (url.startsWith(API)) {
+        if (req.method() === "OPTIONS") return route.fulfill({ status: 204, headers: cors });
+        const key = `${req.method()} ${url.slice(API.length)}`;
+        const fault = faults.find(f => f.match.test(key));
+        if (fault?.delay) await new Promise(r => setTimeout(r, fault.delay));
+        if (fault?.abort) {
+          log.push(`${key} -> aborted`);
+          return route.abort("failed");
+        }
+        if (fault?.status) {
+          log.push(`${key} -> ${fault.status}`);
+          return route.fulfill({ status: fault.status, contentType: "application/json", headers: cors, body: JSON.stringify({ errors: { server: ["error"] } }) });
+        }
+        const body = req.postData() ? JSON.parse(req.postData()) : undefined;
+        const [status, json] = handle(req.method(), url, body, req.headers()["authorization"]);
+        log.push(`${req.method()} ${url.slice(API.length)} -> ${status}`);
+        if (delay) await new Promise(r => setTimeout(r, delay));
+        return route.fulfill({ status, contentType: "application/json", headers: cors, body: JSON.stringify(json) });
+      }
+      if (url.startsWith("http://127.0.0.1") || url.startsWith("http://localhost")) {
+        if (/\/img\//.test(url)) return route.fulfill({ status: 200, contentType: "image/png", body: PNG });
+        return route.continue();
+      }
+      // Fonts, CDN CSS and anything else external: blocked here, fulfil empty.
+      return route.fulfill({ status: 200, contentType: url.endsWith(".css") ? "text/css" : "text/plain", body: "" });
+    });
+  }
+  return { install, log, handle };
+}
+
+const cors = { "access-control-allow-origin": "*", "access-control-allow-headers": "*", "access-control-allow-methods": "*" };
+const PNG = Buffer.from(
+  "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=",
+  "base64"
+);
diff --git a/e2e/serve.mjs b/e2e/serve.mjs
new file mode 100644
index 0000000..3050d21
--- /dev/null
+++ b/e2e/serve.mjs
@@ -0,0 +1,25 @@
+// Tiny static server: node e2e/serve.mjs <dir> <port>
+import { createServer } from "node:http";
+import { readFile, stat } from "node:fs/promises";
+import { join, extname, resolve } from "node:path";
+
+const [dir = "public", port = "5000"] = process.argv.slice(2);
+const root = resolve(dir);
+const types = { ".html": "text/html", ".js": "text/javascript", ".css": "text/css", ".png": "image/png", ".svg": "image/svg+xml", ".map": "application/json" };
+
+createServer(async (req, res) => {
+  let p = decodeURIComponent(new URL(req.url, "http://x").pathname);
+  let file = join(root, p);
+  if (!file.startsWith(root)) return res.writeHead(403).end();
+  try {
+    if ((await stat(file)).isDirectory()) file = join(file, "index.html");
+  } catch {
+    file = join(root, "index.html");
+  }
+  try {
+    const body = await readFile(file);
+    res.writeHead(200, { "content-type": types[extname(file)] || "application/octet-stream" }).end(body);
+  } catch {
+    res.writeHead(404).end("not found");
+  }
+}).listen(+port, "127.0.0.1", () => console.log(`serving ${root} on http://127.0.0.1:${port}`));
