{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ESNext", "DOM"],
    "allowJs": true, "strict": true, "skipLibCheck": true, "noEmit": true,
    "jsx": "preserve", "jsxImportSource": "@solidjs/web",
    "plugins": [{ "name": "ts-plugin-solid-yield", "mode": "native", "include": ["src/**"] }]
  },
  "include": ["src"]
}
