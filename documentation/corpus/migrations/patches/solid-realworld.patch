+import { Show, useContext } from "solid-js";
+import { StoreContext, RouterContext } from "../../store";
+import NavLink from "../../components/NavLink";
+import ArticleList from "../../components/ArticleList";
+
+export default function Profile(props: { username: string }) {
+  const [store, { unfollow, follow }] = useContext(StoreContext),
+    { location } = useContext(RouterContext),
+
+    isUser = () => props.username === store.currentUser()?.username;
+
+  return (
+    <div class="profile-page">
+      <div class="user-info">
+        <div class="container">
+          <div class="row">
+            <div class="col-xs-12 col-md-10 offset-md-1">
+              <img src={store.profile()?.image ?? undefined} class="user-img" alt="" />
+              <h4 textContent={props.username} />
+              <p>{store.profile()?.bio}</p>
+              {isUser() && (
+                <NavLink route="settings" class="btn btn-sm btn-outline-secondary action-btn">
+                  <i class="ion-gear-a" /> Edit Profile Settings
+                </NavLink>
+              )}
+              {/* One button whose click read store.profile() became two: reading the profile
+                  memo in the handler is reported as an unhandled failure (EVENT_REJECTS). */}
+              {store.token() && !isUser() && (
+                <Show
+                  when={store.profile()?.following}
+                  fallback={
+                    <button
+                      class="btn btn-sm action-btn btn-outline-secondary"
+                      onClick={ev => {
+                        ev.preventDefault();
+                        const name = props.username;
+                        follow(name);
+                      }}
+                    >
+                      <i class="ion-plus-round" /> Follow {store.profile()?.username}
+                    </button>
+                  }
+                >
+                  <button
+                    class="btn btn-sm action-btn btn-secondary"
+                    onClick={ev => {
+                      ev.preventDefault();
+                      const name = props.username;
+                      unfollow(name);
+                    }}
+                  >
+                    <i class="ion-plus-round" /> Unfollow {store.profile()?.username}
+                  </button>
+                </Show>
+              )}
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <div class="container">
+        <div class="row">
+          <div class="col-xs-12 col-md-10 offset-md-1">
+            <div class="articles-toggle">
+              <ul class="nav nav-pills outline-active">
+                <li class="nav-item">
+                  <NavLink
+                    class="nav-link"
+                    active={location().includes("/favorites") ? 0 : 1}
+                    href={`@${props.username}`}
+                  >
+                    My Articles
+                  </NavLink>
+                </li>
+
+                <li class="nav-item">
+                  <NavLink
+                    class="nav-link"
+                    active={location().includes("/favorites")}
+                    href={`@${props.username}/favorites`}
+                  >
+                    Favorited Articles
+                  </NavLink>
+                </li>
+              </ul>
+            </div>
+
+            <ArticleList
+              articles={Object.values(store.articles())}
+              totalPagesCount={store.totalPagesCount()}
+              // Was onSetPage={handleSetPage} (setPage + loadArticles() with no predicate, as here).
+            />
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
