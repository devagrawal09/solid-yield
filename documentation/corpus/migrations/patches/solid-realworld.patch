+++ b/src/store/createArticles.ts
@@ -0,0 +1,98 @@
+import { action, createMemo, createSignal, refresh } from "solid-js";
+import type { Agent, Result } from "./createAgent";
+import type { Article, ArticleDraft, Predicate } from "../types";
+export const LIMIT = 10;
+
+interface ArticlesValue {
+  map: Record<string, Article>;
+  count: number;
+}
+type Source = ["articles", Predicate | undefined] | ["article", string];
+
+export default function createArticles(agent: Agent) {
+  // New: the last failed action, shown by App. A catch that writes a signal declared here counts
+  // as handling; a setter received as a parameter is reported as CATCH_SWALLOWS.
+  const [error, setError] = createSignal<string | undefined>(undefined);
+  const [page, setPage] = createSignal(0);
+  const [articleSource, setArticleSource] = createSignal<Source | undefined>(undefined);
+  // Was createResource(articleSource, fetcher, { initialValue: {} }); the fetcher's previous
+  // value is the memo's previous value.
+  const value = createMemo((prev?: ArticlesValue) => {
+    const current = prev ?? { map: {}, count: 0 };
+    const args = articleSource();
+    if (!args) return current;
+    if (args[0] === "articles") {
+      return $req(args[1] ?? {}, page()).then(({ articles, articlesCount }) => ({
+        map: Object.fromEntries(articles.map(article => [article.slug, article])),
+        count: articlesCount
+      }));
+    }
+    const slug = args[1];
+    if (current.map[slug]) return current;
+    return agent.Articles.get(slug).then(article => ({ ...current, map: { ...current.map, [slug]: article } }));
+  });
+  const articles = createMemo(() => value().map);
+  const totalPagesCount = createMemo(() => Math.ceil(value().count / LIMIT));
+
+  function $req(predicate: Predicate, page: number) {
+    if (predicate.myFeed) return agent.Articles.feed();
+    if (predicate.favoritedBy) return agent.Articles.favoritedBy(predicate.favoritedBy, page);
+    if (predicate.tag) return agent.Articles.byTag(predicate.tag, page, LIMIT);
+    if (predicate.author) return agent.Articles.byAuthor(predicate.author, page);
+    return agent.Articles.all(page, LIMIT);
+  }
+
+  // The Solid 1 actions wrote optimistic values through the store into the resource value
+  // (and reverted on failure). A read-only memo cannot be written, so each action now waits for
+  // the server and refreshes the memo.
+  const actions = {
+    setPage,
+    loadArticles: action(function* (predicate?: Predicate) {
+      setArticleSource(["articles", predicate]);
+    }),
+    loadArticle: action(function* (slug: string) {
+      setArticleSource(["article", slug]);
+    }),
+    // The caller (ArticlePreview) decides between favorite and unfavorite from the article it shows.
+    makeFavorite: action(function* (slug: string) {
+      setError(undefined);
+      try {
+        yield agent.Articles.favorite(slug);
+        refresh(value);
+      } catch (err) {
+        setError("Could not update the favorite.");
+      }
+    }),
+    unmakeFavorite: action(function* (slug: string) {
+      setError(undefined);
+      try {
+        yield agent.Articles.unfavorite(slug);
+        refresh(value);
+      } catch (err) {
+        setError("Could not update the favorite.");
+      }
+    }),
+    createArticle: action(function* (newArticle: ArticleDraft) {
+      const { article, errors }: Result<"article", Article> = yield agent.Articles.create(newArticle);
+      if (errors) throw errors;
+      return article;
+    }),
+    updateArticle: action(function* (data: ArticleDraft) {
+      const { article, errors }: Result<"article", Article> = yield agent.Articles.update(data);
+      if (errors) throw errors;
+      refresh(value);
+      return article;
+    }),
+    deleteArticle: action(function* (slug: string) {
+      setError(undefined);
+      try {
+        yield agent.Articles.del(slug);
+        refresh(value);
+        location.hash = "/";
+      } catch (err) {
+        setError("Could not delete the article.");
+      }
+    })
+  };
+  return { error, articles, totalPagesCount, page, actions };
+}
