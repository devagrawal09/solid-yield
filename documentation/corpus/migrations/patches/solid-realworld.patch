+import { action, createMemo, createSignal, refresh } from "solid-js";
+import type { Agent } from "./createAgent";
+
+export default function createProfile(agent: Agent) {
+  // New: the last failed action, shown by App. A catch that writes a signal declared here counts
+  // as handling; a setter received as a parameter is reported as CATCH_SWALLOWS.
+  const [error, setError] = createSignal<string | undefined>(undefined);
+  const [username, setUsername] = createSignal<string | undefined>(undefined);
+  const profile = createMemo(() => {
+    const name = username();
+    return name ? agent.Profile.get(name) : undefined;
+  });
+  // Was an optimistic write through the store, reverted (and the error swallowed) on failure;
+  // now follow, then refetch, and report a failure. Profile passes the username it shows.
+  const actions = {
+    loadProfile: setUsername,
+    follow: action(function* (name: string) {
+      setError(undefined);
+      try {
+        yield agent.Profile.follow(name);
+        refresh(profile);
+      } catch (err) {
+        setError("Could not update the follow status.");
+      }
+    }),
+    unfollow: action(function* (name: string) {
+      setError(undefined);
+      try {
+        yield agent.Profile.unfollow(name);
+        refresh(profile);
+      } catch (err) {
+        setError("Could not update the follow status.");
+      }
+    })
+  };
+  return { error, profile, actions };
+}
