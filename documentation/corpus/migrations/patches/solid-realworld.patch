@@ -0,0 +1,59 @@
+import { For, useContext } from "solid-js";
+import NavLink from "./NavLink";
+import { StoreContext } from "../store";
+import type { Article } from "../types";
+
+const FAVORITED_CLASS = "btn btn-sm btn-primary";
+const NOT_FAVORITED_CLASS = "btn btn-sm btn-outline-primary";
+
+export default function ArticlePreview(props: { article: Article; token?: string | null }) {
+  // Was ArticleList's handleClickFavorite, passed down as onClickFavorite (repro 11). The original
+  // passed an undeclared `slug` (ReferenceError on click).
+  const [, { makeFavorite, unmakeFavorite }] = useContext(StoreContext);
+  return (
+    <div class="article-preview">
+      <div class="article-meta">
+        <NavLink href={`@${props.article.author.username}`} route="profile">
+          <img src={props.article.author.image ?? undefined} alt="" />
+        </NavLink>
+
+        <div class="info">
+          <NavLink class="author" href={`@${props.article.author.username}`} route="profile">
+            {props.article.author.username}
+          </NavLink>
+          <span class="date" textContent={new Date(props.article.createdAt).toDateString()} />
+        </div>
+
+        {props.token && (
+          <div class="pull-xs-right">
+            <button
+              class={props.article.favorited ? FAVORITED_CLASS : NOT_FAVORITED_CLASS}
+              onClick={e => {
+                e.preventDefault();
+                // Fields read one by one: members of a hoisted props.article are lowered as reads
+                // of the value they hold (repro 14).
+                const slug = props.article.slug;
+                if (props.article.favorited) unmakeFavorite(slug);
+                else makeFavorite(slug);
+              }}
+            >
+              <i class="ion-heart" /> {props.article.favoritesCount}
+            </button>
+          </div>
+        )}
+      </div>
+
+      <NavLink href={`article/${props.article.slug}`} route="article" class="preview-link">
+        <h1>{props.article.title}</h1>
+        <p>{props.article.description}</p>
+        <span>Read more...</span>
+        <ul class="tag-list">
+          {/* Was tagList.map(...): an array map over a prop in a hole is typed unknown (repro 11). */}
+          <For each={props.article.tagList}>
+            {tag => <li class="tag-default tag-pill tag-outline" textContent={tag} />}
+          </For>
+        </ul>
+      </NavLink>
+    </div>
+  );
+}
