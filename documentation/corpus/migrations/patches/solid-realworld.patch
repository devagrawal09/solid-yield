@@ -0,0 +1,39 @@
+import { action, createMemo, refresh } from "solid-js";
+import type { Accessor, Setter } from "solid-js";
+import type { Agent, Result } from "./createAgent";
+import type { User, UserUpdate } from "../types";
+
+export default function createAuth(
+  agent: Agent,
+  session: { token: string | null | undefined },
+  token: Accessor<string | null | undefined>,
+  setToken: Setter<string | null | undefined>
+) {
+  // Was createResource(loggedIn, agent.Auth.current) + mutate(); keyed on the token now. The
+  // pullUser()/loggedIn signal is gone: App used to write it from its component body.
+  const currentUser = createMemo(() => (token() ? agent.Auth.current() : undefined));
+  const actions = {
+    login: action(function* (email: string, password: string) {
+      const { user, errors }: Result<"user", User> = yield agent.Auth.login(email, password);
+      if (errors) throw errors;
+      session.token = user.token;
+      setToken(user.token);
+    }),
+    register: action(function* (username: string, email: string, password: string) {
+      const { user, errors }: Result<"user", User> = yield agent.Auth.register(username, email, password);
+      if (errors) throw errors;
+      session.token = user.token;
+      setToken(user.token);
+    }),
+    logout: action(function* () {
+      session.token = undefined;
+      setToken(undefined);
+    }),
+    updateUser: action(function* (newUser: UserUpdate) {
+      const { errors }: Result<"user", User> = yield agent.Auth.save(newUser);
+      if (errors) throw errors;
+      refresh(currentUser);
+    })
+  };
+  return { currentUser, actions };
+}
