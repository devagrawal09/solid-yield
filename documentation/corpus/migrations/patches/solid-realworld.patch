@@ -0,0 +1,63 @@
+import { createMemo, Errored, Loading, Match, Show, Switch, useContext } from "solid-js";
+import { StoreContext, RouterContext } from "./store";
+import NavBar from "./components/NavBar";
+import Home from "./pages/Home";
+import Article from "./pages/Article";
+import Profile from "./pages/Profile";
+import Editor from "./pages/Editor";
+// Settings and Auth were lazy(): lazy() of a checked component cannot pass the checker even
+// inside Errored + Loading (repro 10), so every page is imported statically now.
+import Settings from "./pages/Settings";
+import Auth from "./pages/Auth";
+
+export default function App() {
+  const [store] = useContext(StoreContext),
+    { getParams } = useContext(RouterContext),
+    match = (name: string) => (getParams()?.routeName === name ? getParams() : undefined),
+    // Was a signal set from the component body and from a createComputed.
+    appLoaded = createMemo(() => !store.token() || !!store.currentUser());
+
+  return (
+    <Loading fallback={<div class="container">Loading...</div>}>
+      {/* This boundary only exists because NavLink's props inherit the failures of other call
+          sites (repro 15): the static brand/Home links are otherwise reported as failing. */}
+      <Errored fallback={<nav class="navbar navbar-light" />}>
+        <NavBar />
+      </Errored>
+      <Show when={store.notice()}>
+        {notice => (
+          <div class="container">
+            <ul class="error-messages">
+              <li>{notice()}</li>
+            </ul>
+          </div>
+        )}
+      </Show>
+      {/* Errored added: route data (user, article, profile) can reject; the original had no boundary. */}
+      {/* No retry button: calling Errored's reset() is reported as EVENT_REJECTS (repro 12). */}
+      <Errored
+        fallback={
+          <div class="container">
+            <ul class="error-messages">
+              <li>Could not load this page.</li>
+            </ul>
+          </div>
+        }
+      >
+      <Show when={appLoaded()}>
+        <Switch>
+          <Match when={match("editor")}>{route => <Editor params={route().params} />}</Match>
+          <Match when={match("settings")}><Settings /></Match>
+          <Match when={match("login")}><Auth /></Match>
+          <Match when={match("register")}><Auth /></Match>
+          <Match when={match("article")}>{route => <Article params={route().params} />}</Match>
+          <Match when={match("profile")}>
+            {route => <Profile params={route().params} routeName={route().routeName} />}
+          </Match>
+          <Match when={match("")}><Home /></Match>
+        </Switch>
+      </Show>
+      </Errored>
+    </Loading>
+  );
+}
