{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-yield",
    "jsxFactory": "jsx",
    "jsxFragmentFactory": "Fragment",
    "lib": ["ESNext", "DOM"],
    "noEmit": true
  }
}
