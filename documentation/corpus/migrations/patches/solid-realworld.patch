--- /dev/null
+++ b/src/store/createRouteHandler.ts
@@ -0,0 +1,32 @@
+import { createMemo, createSignal, onCleanup } from "solid-js";
+
+// The patterns App.js passed to match(name, regex), in its Switch order. match() used to write
+// the matched params into a closure and poke a signal from inside <Match when>; the current
+// route is now a memo over the location.
+const ROUTES: [string, RegExp][] = [
+  ["editor", /^editor\/?(.*)/],
+  ["settings", /^settings/],
+  ["login", /^login/],
+  ["register", /^register/],
+  ["article", /^article\/(.*)/],
+  ["profile", /^@([^/]*)\/?(favorites)?/],
+  ["", /^#?$/]
+];
+
+export default function createRouteHandler(init: string) {
+  const [location, setLocation] = createSignal(window.location.hash.slice(2) || init),
+    locationHandler = () => setLocation(window.location.hash.slice(2));
+  window.addEventListener("hashchange", locationHandler);
+  onCleanup(() => window.removeEventListener("hashchange", locationHandler));
+  const getParams = createMemo(() => {
+    const loc = location().split("?")[0];
+    for (const [routeName, test] of ROUTES) {
+      const match = test.exec(loc);
+      if (match) return { params: match.slice(1), routeName };
+    }
+    return undefined;
+  });
+  return { location, getParams };
+}
+
+export type Router = ReturnType<typeof createRouteHandler>;
