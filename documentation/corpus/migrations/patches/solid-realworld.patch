+import { createEffect, useContext } from "solid-js";
+import { StoreContext } from "../../store";
+import Article from "./Article"; // was lazy() (repro 10)
+
+export default function ArticleIndex(props: { params: (string | undefined)[] }) {
+  const [, { loadArticle, loadComments }] = useContext(StoreContext);
+  // Was called directly in the component body (a write during setup).
+  createEffect(
+    () => props.params[0],
+    slug => {
+      if (slug) {
+        loadArticle(slug);
+        loadComments(slug);
+      }
+    }
+  );
+  return <Article slug={props.params[0] ?? ""} />;
+}
