@@ -0,0 +1,88 @@
+import { createContext, createMemo, createSignal } from "solid-js";
+import type { Accessor, ParentProps } from "solid-js";
+import createAgent from "./createAgent";
+import createArticles from "./createArticles";
+import createAuth from "./createAuth";
+import createCommon from "./createCommon";
+import createComments from "./createComments";
+import createProfile from "./createProfile";
+import createRouteHandler from "./createRouteHandler";
+
+type Articles = ReturnType<typeof createArticles>;
+type Comments = ReturnType<typeof createComments>;
+type Profiles = ReturnType<typeof createProfile>;
+type Auth = ReturnType<typeof createAuth>;
+
+// Solid 1 kept one store whose getters read the resources (state.articles, state.currentUser, ...).
+// The values are now memos and signals, read as store.articles(), store.currentUser(), ...
+export interface Store {
+  appName: string;
+  notice: Accessor<string | undefined>;
+  token: Accessor<string | null | undefined>;
+  page: Articles["page"];
+  articles: Articles["articles"];
+  totalPagesCount: Articles["totalPagesCount"];
+  comments: Comments["comments"];
+  articleSlug: Comments["articleSlug"];
+  tags: ReturnType<typeof createCommon>["tags"];
+  profile: Profiles["profile"];
+  currentUser: Auth["currentUser"];
+}
+export type Actions = Articles["actions"] &
+  Comments["actions"] &
+  Profiles["actions"] &
+  Auth["actions"];
+export type Conduit = [Store, Actions];
+
+// useStore()/useRouter() hooks removed: consumers call useContext(StoreContext) directly.
+export const StoreContext = createContext<Conduit>();
+export const RouterContext = createContext<ReturnType<typeof createRouteHandler>>();
+
+export function Provider(props: ParentProps) {
+  const router = createRouteHandler(""),
+    saved = localStorage.getItem("jwt"),
+    [token, setToken] = createSignal<string | null | undefined>(saved),
+    session: { token: string | null | undefined } = { token: saved },
+    agent = createAgent(session, setToken);
+  // Composed here rather than in a createConduit() helper: a factory composing other factories
+  // makes every consumer's destructuring a setup read (repro 09).
+  const {
+      articles,
+      totalPagesCount,
+      page,
+      error: articlesError,
+      actions: articleActions
+    } = createArticles(agent),
+    { comments, articleSlug, error: commentsError, actions: commentActions } = createComments(agent),
+    { tags } = createCommon(agent, token),
+    { profile, error: profileError, actions: profileActions } = createProfile(agent),
+    { currentUser, actions: authActions } = createAuth(agent, session, token, setToken);
+  // New: the last failed action, shown above the page.
+  const notice = createMemo(() => articlesError() ?? commentsError() ?? profileError());
+  const store: Store = {
+      appName: "conduit",
+      notice,
+      token,
+      page,
+      articles,
+      totalPagesCount,
+      comments,
+      articleSlug,
+      tags,
+      profile,
+      currentUser
+    },
+    actions: Actions = {
+      ...articleActions,
+      ...commentActions,
+      ...profileActions,
+      ...authActions
+    },
+    conduit: Conduit = [store, actions];
+
+  return (
+    <RouterContext value={router}>
+      <StoreContext value={conduit}>{props.children}</StoreContext>
+    </RouterContext>
+  );
+}
