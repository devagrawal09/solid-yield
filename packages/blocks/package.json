{
  "name": "solid-blocks",
  "description": "Generator blocks for Solid as a library: strict, typed generator syntax and a runtime interpreter on Solid's public API (no blocks compiler).",
  "version": "0.0.0",
  "author": "Dev Agrawal <dev@codemod.com>",
  "license": "MIT",
  "homepage": "https://github.com/devagrawal09/solid-blocks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devagrawal09/solid-blocks.git",
    "directory": "packages/blocks"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/server.js",
  "module": "./dist/server.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "jsx",
    "NOTICE",
    "package.json"
  ],
  "exports": {
    ".": {
      "worker": {
        "types": "./dist/types/index.d.ts",
        "development": "./dist/server.dev.js",
        "default": "./dist/server.js"
      },
      "browser": {
        "types": "./dist/types/index.d.ts",
        "development": "./dist/blocks.dev.js",
        "default": "./dist/blocks.js"
      },
      "deno": {
        "types": "./dist/types/index.d.ts",
        "development": "./dist/server.dev.js",
        "default": "./dist/server.js"
      },
      "node": {
        "types": "./dist/types/index.d.ts",
        "development": "./dist/server.dev.js",
        "default": "./dist/server.js"
      },
      "types": "./dist/types/index.d.ts",
      "development": "./dist/blocks.dev.js",
      "default": "./dist/blocks.js"
    },
    "./internal": {
      "worker": {
        "types": "./dist/types/internal.d.ts",
        "development": "./dist/internal.server.dev.js",
        "default": "./dist/internal.server.js"
      },
      "browser": {
        "types": "./dist/types/internal.d.ts",
        "development": "./dist/internal.dev.js",
        "default": "./dist/internal.js"
      },
      "deno": {
        "types": "./dist/types/internal.d.ts",
        "development": "./dist/internal.server.dev.js",
        "default": "./dist/internal.server.js"
      },
      "node": {
        "types": "./dist/types/internal.d.ts",
        "development": "./dist/internal.server.dev.js",
        "default": "./dist/internal.server.js"
      },
      "types": "./dist/types/internal.d.ts",
      "development": "./dist/internal.dev.js",
      "default": "./dist/internal.js"
    },
    "./h": {
      "types": "./dist/types/h.d.ts",
      "development": "./dist/h.dev.js",
      "default": "./dist/h.js"
    },
    "./jsx-runtime": {
      "types": "./jsx/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm-run-all -nl build:clean build:js types",
    "build:clean": "rimraf dist/",
    "build:js": "node scripts/build.mjs",
    "types": "npm-run-all -nl types:jsx types:src",
    "types:src": "tsc -p tsconfig.build.json",
    "types:jsx": "node scripts/jsx-from-web.mjs && node scripts/jsx-web-shared.mjs",
    "test": "vitest run --maxWorkers=2 && vitest run --maxWorkers=2 --config vite.config.prod.mjs && vitest run --maxWorkers=2 --config vite.config.server.mjs && pnpm run test-types",
    "test-types": "tsc -p tsconfig.json",
    "test:exports": "node --test test/exports-matrix.test.mjs",
    "test:conformance": "vitest run --config vite.config.conformance-server.mjs && vitest run --config vite.config.conformance-hydrate.mjs && vitest run --config vite.config.conformance.mjs && node test/conformance/lint.mjs"
  },
  "peerDependencies": {
    "@solidjs/h": "^2.0.0-rc.11",
    "@solidjs/web": "^2.0.0-rc.11",
    "solid-js": "^2.0.0-rc.11"
  },
  "peerDependenciesMeta": {
    "@solidjs/h": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/compiler": "^2.0.0-rc.11",
    "@solidjs/h": "^2.0.0-rc.11",
    "@solidjs/vite-plugin": "3.0.0-next.35",
    "@solidjs/web": "^2.0.0-rc.11",
    "csstype": "^3.1.0",
    "solid-js": "^2.0.0-rc.11"
  }
}
