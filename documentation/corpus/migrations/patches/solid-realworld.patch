+import { defineConfig } from "vite";
+import solid from "@solidjs/vite-plugin";
+import solidYield from "vite-plugin-solid-yield";
+
+// SOLID_YIELD=1 builds through solid-yield's native mode (the checked lowering); otherwise this is
+// a plain Solid 2 build with Solid's own plugin only.
+const yieldBuild = process.env.SOLID_YIELD === "1";
+
+export default defineConfig({
+  plugins: [...(yieldBuild ? [solidYield({ mode: "native", include: ["src/**"] })] : []), solid()],
+  build: { outDir: yieldBuild ? "dist-yield" : "dist", sourcemap: true }
+});
