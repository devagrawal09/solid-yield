+import { parseProgram } from "./transform.js";
+const t = babel.types;
+const helper = `type __NativeProvided<C, D, Q> = C extends (...args: any[]) => import("solid-yield").ComponentView<infer P extends boolean, infer E, infer W extends boolean, infer R>
