@@ -0,0 +1,18 @@
+import { useContext } from "solid-js";
+import type { JSX } from "@solidjs/web";
+import { RouterContext } from "../store";
+
+export default function NavLink(
+  props: { class?: string; active?: boolean | number; href?: string; route?: string; children?: JSX.Element }
+) {
+  const { getParams } = useContext(RouterContext);
+  return (
+    <a
+      class={[props.class, { active: !!props.active || getParams()?.routeName === props.route }]}
+      href={`#/${props.href || props.route}`}
+      onClick={() => window.scrollTo(0, 0)}
+    >
+      {props.children}
+    </a>
+  );
+}
