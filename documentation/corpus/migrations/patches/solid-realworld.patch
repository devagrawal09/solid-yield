+import { Errored, For, Loading, Show, useContext } from "solid-js";
+import NavLink from "../../components/NavLink";
+import ArticleList from "../../components/ArticleList";
+import { StoreContext } from "../../store";
+import { predicateFor } from "./predicate";
+
+export default function Home(props: { appName: string; token?: string | null; tab: string | null }) {
+  const [store] = useContext(StoreContext);
+  return (
+    <div class="home-page">
+      <div class="banner">
+        <div class="container">
+          <h1 class="logo-font" textContent={props.appName} />
+          <p>A place to share your knowledge.</p>
+        </div>
+      </div>
+
+      <div class="container page">
+        <div class="row">
+          <div class="col-md-9">
+            <div class="feed-toggle">
+              <ul class="nav nav-pills outline-active">
+                {props.token && (
+                  <li class="nav-item">
+                    <NavLink class="nav-link" href="?tab=feed" active={props.tab === "feed"}>
+                      Your Feed
+                    </NavLink>
+                  </li>
+                )}
+                <li class="nav-item">
+                  <NavLink class="nav-link" href="?tab=all" active={props.tab === "all"}>
+                    Global Feed
+                  </NavLink>
+                </li>
+                <Show when={props.tab !== "all" && props.tab !== "feed"}>
+                  <li class="nav-item">
+                    <a href="" class="nav-link active">
+                      <i class="ion-pound" /> {props.tab}
+                    </a>
+                  </li>
+                </Show>
+              </ul>
+            </div>
+
+            <ArticleList
+              articles={Object.values(store.articles())}
+              totalPagesCount={store.totalPagesCount()}
+              currentPage={store.page()}
+              // Was Home/index's handleSetPage (setPage + loadArticles inside useTransition's
+              // start()); ArticleList now pages through the context with this predicate.
+              predicate={predicateFor(props.tab)}
+            />
+          </div>
+
+          <div class="col-md-3">
+            <div class="sidebar">
+              <p>Popular Tags</p>
+              <Errored fallback="Could not load tags.">
+                <Loading fallback="Loading tags...">
+                  <div class="tag-list">
+                    <For each={store.tags()}>
+                      {tag => (
+                        <a href={`#/?tab=${tag}`} class="tag-pill tag-default">
+                          {tag}
+                        </a>
+                      )}
+                    </For>
+                  </div>
+                </Loading>
+              </Errored>
+            </div>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
