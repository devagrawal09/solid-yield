diff --git a/e2e/compare.mjs b/e2e/compare.mjs
new file mode 100644
index 0000000..af240cb
--- /dev/null
+++ b/e2e/compare.mjs
@@ -0,0 +1,28 @@
+// Compare two flow output dirs: node e2e/compare.mjs <baselineDir> <otherDir>
+import { readdirSync, readFileSync, existsSync } from "node:fs";
+const [a, b] = process.argv.slice(2);
+const files = new Set([...readdirSync(a), ...readdirSync(b)].filter(f => f.endsWith(".json") && f !== "summary.json"));
+let diffs = 0;
+for (const f of [...files].sort()) {
+  if (!existsSync(`${a}/${f}`) || !existsSync(`${b}/${f}`)) {
+    console.log(`ONLY-IN ${existsSync(`${a}/${f}`) ? a : b}: ${f}`);
+    diffs++;
+    continue;
+  }
+  const x = JSON.parse(readFileSync(`${a}/${f}`, "utf8")), y = JSON.parse(readFileSync(`${b}/${f}`, "utf8"));
+  for (const k of new Set([...Object.keys(x), ...Object.keys(y)])) {
+    if (JSON.stringify(x[k]) !== JSON.stringify(y[k])) {
+      diffs++;
+      console.log(`DIFF ${f} .${k}\n  base: ${JSON.stringify(x[k]).slice(0, 400)}\n  new : ${JSON.stringify(y[k]).slice(0, 400)}`);
+    }
+  }
+}
+const sa = JSON.parse(readFileSync(`${a}/summary.json`, "utf8")), sb = JSON.parse(readFileSync(`${b}/summary.json`, "utf8"));
+for (const k of Object.keys(sa)) {
+  if (sa[k]?.status !== sb[k]?.status) console.log(`STATUS ${k}: ${sa[k]?.status} -> ${sb[k]?.status} ${sb[k]?.failure || ""}`);
+  const ea = (sa[k]?.errors || []).join("\n"), eb = (sb[k]?.errors || []).join("\n");
+  if (ea !== eb) console.log(`ERRORS ${k}:\n  base: ${ea.slice(0, 300)}\n  new : ${eb.slice(0, 300)}`);
+  const la = (sa[k]?.api || []).join("\n"), lb = (sb[k]?.api || []).join("\n");
+  if (la !== lb) console.log(`API ${k}:\n  base: ${(sa[k]?.api || []).join(" | ")}\n  new : ${(sb[k]?.api || []).join(" | ")}`);
+}
+console.log(`${diffs} snapshot field differences`);
diff --git a/e2e/flows.mjs b/e2e/flows.mjs
