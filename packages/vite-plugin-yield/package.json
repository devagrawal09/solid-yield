{
  "name": "vite-plugin-solid-yield",
  "description": "The JSX transform's one yield rule for solid-yield (`yield*` in a JSX hole becomes `perform(…)`), as a Vite plugin, a Babel plugin and a plain transform; also annotates the library's `lazy()` with its module URL.",
  "version": "0.0.0",
  "author": "Dev Agrawal <dev@codemod.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devagrawal09/solid-yield.git",
    "directory": "packages/vite-plugin-yield"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc -p tsconfig.json",
    "test:exports": "node --test test/exports-matrix.test.mjs"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "magic-string": "^0.30.21"
  },
  "peerDependencies": {
    "solid-yield": "workspace:^",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "solid-yield": "workspace:*",
    "@solidjs/compiler": "^2.0.0-rc.11",
    "@solidjs/vite-plugin": "3.0.0-next.35",
    "@solidjs/web": "^2.0.0-rc.11",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.6.0",
    "solid-js": "^2.0.0-rc.11",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.6"
  }
}
